# Massive Rocket Lead Qualification Platform
# Copy this file to .env and fill in your values.
# In production, set these in the Railway dashboard (Project Settings -> Variables).

# Apollo.io REST API key
# Apollo admin: Settings -> Integrations -> API
APOLLO_API_KEY=

# Notion integration token
# https://www.notion.so/my-integrations
NOTION_API_KEY=

# Notion "Lead Qualification Tracker" data source ID
# (data source is the new 2025-09+ API concept; one per DB view layer)
NOTION_DATA_SOURCE_ID=31051ecc-2410-4a71-b885-f21c8dd52ba3

# Optional: parent database ID. Auto-resolved from the data source if blank.
NOTION_DATABASE_ID=

# Optional: pin Notion API version. Defaults to 2025-09-03.
NOTION_API_VERSION=2025-09-03

# Anthropic API key (optional, only needed for AI-assisted fit summaries)
ANTHROPIC_API_KEY=

# Flask
FLASK_SECRET_KEY=change-me
PORT=5050

# Shared-secret access token for the team. If unset, the API is open.
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(24))'
# Distribute via 1Password or Slack DM, not email.
APP_AUTH_TOKEN=

# Apollo client cache directory (file-based, 24h TTL).
# Stays inside the repo by default; gitignored.
APOLLO_CACHE_DIR=cache/apollo

# Set to 1 to bypass Apollo network calls and use fixture data.
# Useful in CI / when no API key is available.
APOLLO_USE_FIXTURES=0

# --- v0.3 / v0.5 additions -------------------------------------------------

# Slack incoming webhook for the weekly digest (optional).
# Get from: https://api.slack.com/apps -> Your App -> Incoming Webhooks
SLACK_WEBHOOK_URL=

# HubSpot integration. **Disabled by default** per the product brief
# (awaiting CEO approval). Both vars must be set to activate:
HUBSPOT_API_KEY=
HUBSPOT_SYNC_ENABLED=0

# Audit log path. Defaults to cache/audit.jsonl (gitignored).
AUDIT_LOG_PATH=
