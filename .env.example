# Massive Rocket Lead Qualification Platform
# Copy this file to .env and fill in your values

# Anthropic API Configuration (for AI-powered company research)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion API Configuration (for saving leads)
# Get your API key from: https://www.notion.so/my-integrations
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion Database ID
# Create a database in Notion, share it with your integration, then copy the ID from the URL
# URL format: https://www.notion.so/your-workspace/DATABASE_ID?v=...
NOTION_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
